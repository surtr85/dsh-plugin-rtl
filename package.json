    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "rtl",
    "bidi",
    "persian",
    "arabic",
    "vazirmatn",
    "typography"
  ],
  "homepage": "https://github.com/surtr85/dsh-plugin-rtl#readme",
  "bugs": {
    "url": "https://github.com/surtr85/dsh-plugin-rtl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surtr85/dsh-plugin-rtl.git"
  },
  "license": "MIT",
  "author": "Sajjad <surtr85>",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
